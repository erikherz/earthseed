# Security headers for the static client.
#
# These have to live here rather than in the Worker: with no `run_worker_first` in
# wrangler.jsonc, Cloudflare's asset server answers /broadcast.html, /watch.html and
# /earthseed.js directly and the Worker never sees those requests. (The Worker sets the
# same headers on the responses it does serve, e.g. "/".)
#
# THE POLICY LINES BELOW ARE GENERATED. `script-src` carries a sha256 for each inline
# <script> block in the pages, so editing a page — even its whitespace — invalidates them,
# and a stale hash does not fail loudly: the browser just refuses the script and the page
# does nothing. After touching any page in simple/, run:
#
#     node scripts/csp-hashes.mjs --write
#
# and run it without --write to check for drift before deploying.
#
# The strict policy currently ships as Report-Only while the enforced header stays on the
# subset that cannot break anything. Chrome is verified clean; Safari/iOS is the reason for
# the caution, since it is the browser most likely to disagree about import maps and worklets
# and the one hardest to debug in the field. Violations POST to /api/csp-report; watch them
# with `npx wrangler tail`. Flip ENFORCE in scripts/csp-hashes.mjs once real devices are quiet.
/*
  # BEGIN generated policy
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'none'; object-src 'none'
  Content-Security-Policy-Report-Only: script-src 'self' 'sha256-7fFJleZc815CALN3PfPMsYa6Qz0a0rce/C4FxOk3/zU=' 'sha256-JCWAMn2pbmcJ89ksB/yW3efkkVZYIE7LtjDSTPgDF20=' 'sha256-sTYgfQK0g22fa73j8zdiZu5nPo2iXzr+QXxAF+ctaBs='; connect-src 'self' https://tinymoq.com https://*.moqcdn.net:*; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; report-uri /api/csp-report
  # END generated policy
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
