{
  "name": "earthseed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "npm run check && wrangler deploy",
    "check": "node scripts/csp-hashes.mjs && node scripts/integrity.mjs --check",
    "csp": "node scripts/csp-hashes.mjs --write",
    "integrity": "node scripts/integrity.mjs --write",
    "bundle": "npm run check && node scripts/bundle.mjs",
    "verify": "node scripts/integrity.mjs --verify",
    "keygen": "node scripts/moq-keygen.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p simple/tsconfig.json",
    "cf-typegen": "wrangler types",
    "//e2e": "These run against a DEPLOYED origin, not a local build — there is no local build. Pass --admin <password> where a suite mints its own publish key.",
    "e2e": "node scripts/e2e/control-plane.mjs && node scripts/e2e/no-key-no-publish.mjs",
    "e2e:media": "node scripts/e2e/broadcast-watch.mjs"
  },
  "devDependencies": {
    "puppeteer": "^25.7.0",
    "typescript": "^5.5.2",
    "wrangler": "^4.54.0"
  }
}
